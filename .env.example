# Обязательный OAuth-токен Яндекс Музыки (используется для чтения библиотеки и плейлистов)
YANDEX_MUSIC_TOKEN=

# Необязательно: принудительный IP-адрес ПК в локальной сети (например, 192.168.1.10)
LOCAL_IP=

# Необязательно: порт HTTP/WebSocket-сервера пульта (по умолчанию 8001)
PORT=8001

# Необязательно: порт Chrome DevTools Protocol десктопной Яндекс Музыки (по умолчанию 9222)
CDP_PORT=9222
